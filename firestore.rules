rules_version = '2';

// Règles d'accès de Gestion Patro.
//
// Trois rôles, lus sur la fiche users/{uid} du compte connecté :
//   - anime      : voit les boulots, y répond, en propose
//   - animateur  : tout dans sa section (bar, finances, comptes, validation...)
//   - admin      : toutes les sections, plus les comptes admin et les saisons
// Un compte « pending » ou « disabled » ne lit que sa propre fiche.
//
// Deux sections, séparées : les garçons à la racine (historique) et sous
// seasons/{sid}/..., les filles sous sections/filles/... Un compte ne voit
// que sa section ; un admin les voit toutes.
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------ helpers
    function signedIn() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function hasProfile() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isActive() {
      return hasProfile() && me().status == 'active';
    }

    function isAdmin() {
      return isActive() && me().role == 'admin';
    }

    // Compte actif de cette section, ou admin.
    function isActiveIn(sec) {
      return isActive() && (me().role == 'admin' || me().sectionId == sec);
    }

    // Animateur de cette section, ou admin.
    function isManagerOf(sec) {
      return isActiveIn(sec) && me().role in ['animateur', 'admin'];
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Premiers admins : deviennent admin à leur première connexion, sinon
    // personne ne pourrait valider le tout premier compte.
    function isBootstrapAdmin() {
      return request.auth.token.email_verified == true
        && request.auth.token.email.lower() in ['rscokart@gmail.com'];
    }

    // ------------------------------------------------------------ comptes
    match /users/{uid} {
      // Sa propre fiche toujours ; celles des autres pour tout compte actif
      // (voir qui a accès à l'app).
      allow read: if signedIn() && (request.auth.uid == uid || isActive());

      // Création de sa propre fiche, en attente. Le rôle vient d'un animateur.
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email.lower()
        && (
          (request.resource.data.status == 'pending'
            && request.resource.data.role == null
            && request.resource.data.sectionId == null
            && request.resource.data.broId == null)
          || (isBootstrapAdmin()
            && request.resource.data.status == 'active'
            && request.resource.data.role == 'admin')
        );

      // Soi-même : son Bro et ses infos d'affichage, jamais son rôle ni son statut.
      allow update: if signedIn() && request.auth.uid == uid
        && changedKeys().hasOnly(['broId', 'displayName', 'photoURL', 'lastLoginAt', 'updatedAt', 'updatedBy']);

      // Un animateur valide et règle les comptes en attente et ceux de sa
      // section, dans sa section. Seul un admin touche à un admin, nomme un
      // admin, ou place un compte dans une autre section.
      allow update: if isActive() && me().role in ['animateur', 'admin'] && request.auth.uid != uid
        && changedKeys().hasOnly(['role', 'sectionId', 'status', 'broId', 'validatedAt', 'updatedAt', 'updatedBy'])
        && (isAdmin() || (
          resource.data.role != 'admin'
          && request.resource.data.role != 'admin'
          && (resource.data.sectionId == null || resource.data.sectionId == me().sectionId)
          && request.resource.data.sectionId == me().sectionId
        ));

      allow delete: if isAdmin() && request.auth.uid != uid;
    }

    // Jetons de notification : chaque appareil écrit le sien. La Cloud
    // Function qui les lit passe par le SDK admin, hors règles.
    match /fcmTokens/{token} {
      allow read: if isActive() && me().role in ['animateur', 'admin'];
      allow create, update: if isActive();
      allow delete: if isActive() && me().role in ['animateur', 'admin'];
    }

    // ------------------------------------------------------------ saison
    // Collections réservées aux animateurs : réglages des boulots et voyage.
    function isManagerOnlyColl(coll) {
      return coll in ['jobSettings', 'tripSettings', 'tripExpenses', 'tripEvents'];
    }

    // Bar et finances : les animés les consultent (carte, ardoises, caisse),
    // mais n'y écrivent que ce qu'exige une commande au bar, voir plus bas.
    function isBarOrFinanceColl(coll) {
      return coll in [
        'members', 'products', 'orders', 'stockMovements', 'financialTransactions',
        'financialGoals', 'popularProducts', 'barSettings', 'surpriseSettings'
      ];
    }

    function isSeasonColl(coll) {
      return isManagerOnlyColl(coll) || isBarOrFinanceColl(coll)
        || coll in ['bros', 'jobs', 'scheduledJobs'];
    }

    // Ce qu'un animé écrit en passant une commande au bar. Tout le reste du
    // bar et toutes les finances (entrées, sorties, rechargements, dépôts)
    // restent réservés aux animateurs.
    //  - orders : une consommation, jamais un rechargement ;
    //  - stockMovements : la trace de la sortie de stock ;
    //  - surpriseSettings : le stock des produits exclusifs du verre surprise,
    //    réécrit à chaque tirage.
    function animeCreatesBarDoc(coll) {
      return (coll == 'orders' && request.resource.data.type == 'order')
        || coll == 'stockMovements'
        || coll == 'surpriseSettings';
    }

    // Une commande ne peut que débiter une ardoise et faire sortir du stock :
    // un animé ne peut ni se recréditer, ni regonfler un stock.
    function animeUpdatesBarDoc(coll) {
      return (coll == 'members'
          && changedKeys().hasOnly(['balance', 'updatedAt'])
          && request.resource.data.balance <= resource.data.balance)
        || (coll == 'products'
          && changedKeys().hasOnly(['stock', 'updatedAt'])
          && request.resource.data.stock <= resource.data.stock);
    }

    // Un boulot ouvert à l'autre section se lit depuis l'autre section, avec
    // une requête filtrée sur openToOtherSection == true.
    function isOpenJob(coll) {
      return coll == 'scheduledJobs' && isActive() && resource.data.openToOtherSection == true;
    }

    function canReadSeasonDoc(sec, coll) {
      return isSeasonColl(coll) && (
        isManagerOf(sec)
        || (isActiveIn(sec) && !isManagerOnlyColl(coll))
        || isOpenJob(coll)
      );
    }

    // Les boulots faits (jobs) ne sont créés que par la validation, réservée
    // aux animateurs : un animé ne peut pas s'inventer des heures.
    // Un boulot ouvert à l'autre section, validé par son organisateur, crée le
    // boulot fait de chaque participant dans la section de celui-ci : l'animateur
    // organisateur écrit alors chez l'autre section, en signant sa section.
    function canCreateSeasonDoc(sec, coll) {
      return isSeasonColl(coll) && (
        isManagerOf(sec)
        // Proposer un boulot : l'auteur est enregistré.
        || (coll == 'scheduledJobs' && isActiveIn(sec) && request.resource.data.createdBy == request.auth.uid)
        // Passer une commande au bar.
        || (isActiveIn(sec) && animeCreatesBarDoc(coll))
        || (coll == 'jobs'
          && request.resource.data.crossSectionFrom is string
          && request.resource.data.crossSectionFrom != sec
          && isManagerOf(request.resource.data.crossSectionFrom))
      );
    }

    function canUpdateSeasonDoc(sec, coll) {
      return isSeasonColl(coll) && (
        isManagerOf(sec)
        // Répondre à un boulot, inscrire ou retirer quelqu'un ; l'auteur peut tout modifier.
        || (coll == 'scheduledJobs' && isActiveIn(sec) && (
          resource.data.createdBy == request.auth.uid
          || changedKeys().hasOnly(['registeredBros', 'unavailableBros', 'updatedAt'])
        ))
        // Passer une commande au bar : débiter une ardoise, sortir du stock.
        || (isActiveIn(sec) && animeUpdatesBarDoc(coll))
        // Depuis l'autre section : répondre à un boulot ouvert.
        || (isOpenJob(coll) && changedKeys().hasOnly(['registeredBros', 'unavailableBros', 'updatedAt']))
        // Valider un boulot ouvert crédite les heures d'un Bro de l'autre section.
        || (coll == 'bros' && isActive() && me().role in ['animateur', 'admin']
          && changedKeys().hasOnly(['totalHours', 'updatedAt']))
        // Chacun change la photo de son propre Bro.
        || (coll == 'bros' && isActiveIn(sec) && me().broId == resource.id
          && changedKeys().hasOnly(['photoURL', 'updatedAt']))
      );
    }

    function canDeleteSeasonDoc(sec, coll) {
      return isSeasonColl(coll) && (
        isManagerOf(sec)
        // Un animé ne supprime que les boulots qu'il a proposés.
        || (coll == 'scheduledJobs' && isActiveIn(sec) && resource.data.createdBy == request.auth.uid)
      );
    }

    // ------------------------------------------------------------ garçons
    // La saison en cours se lit depuis n'importe quelle section : il faut la
    // connaître pour voir les boulots ouverts de l'autre section.
    match /appState/{doc} {
      allow read: if isActive();
      allow write: if isAdmin();
    }

    match /seasons/{sid} {
      allow read: if isActiveIn('garcons');
      allow write: if isAdmin();

      match /{coll}/{doc} {
        allow read: if canReadSeasonDoc('garcons', coll);
        allow create: if canCreateSeasonDoc('garcons', coll);
        allow update: if canUpdateSeasonDoc('garcons', coll);
        allow delete: if canDeleteSeasonDoc('garcons', coll);
      }
    }

    // Saison historique des garçons, restée aux collections racines. Les noms
    // réservés (users, appState, seasons, sections, fcmTokens) ne sont pas des
    // collections de saison : isSeasonColl les refuse, rien ne s'additionne.
    match /{coll}/{doc} {
      allow read: if canReadSeasonDoc('garcons', coll);
      allow create: if canCreateSeasonDoc('garcons', coll);
      allow update: if canUpdateSeasonDoc('garcons', coll);
      allow delete: if canDeleteSeasonDoc('garcons', coll);
    }

    // ------------------------------------------------------------ autres sections
    match /sections/{sec} {
      allow read: if isActiveIn(sec);
      allow write: if isAdmin();

      match /appState/{doc} {
        allow read: if isActive();
        allow write: if isAdmin();
      }

      match /seasons/{sid} {
        allow read: if isActiveIn(sec);
        allow write: if isAdmin();

        match /{coll}/{doc} {
          allow read: if canReadSeasonDoc(sec, coll);
          allow create: if canCreateSeasonDoc(sec, coll);
          allow update: if canUpdateSeasonDoc(sec, coll);
          allow delete: if canDeleteSeasonDoc(sec, coll);
        }
      }
    }
  }
}
