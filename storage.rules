rules_version = '2';

// Photos des Bro : bros/{section}/{broId}.jpg
// Lecture : tout compte actif. Écriture : un animateur de la section, ou la
// personne dont le compte est relié à ce Bro. Image de 2 Mo maximum.
service firebase.storage {
  match /b/{bucket}/o {
    function profile() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }
    function isActive() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && profile().status == 'active';
    }
    function isManagerOf(sec) {
      return isActive() && profile().role in ['animateur', 'admin']
        && (profile().role == 'admin' || profile().sectionId == sec);
    }

    match /bros/{sec}/{file} {
      allow read: if isActive();
      allow write: if request.resource != null
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*')
        && (isManagerOf(sec) || (isActive() && file == profile().broId + '.jpg' && profile().sectionId == sec));
      allow delete: if isManagerOf(sec);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
