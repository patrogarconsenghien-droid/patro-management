{
  "name": "patro-management",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "pnpm run build && firebase deploy --only hosting",
    "deploy:functions": "node scripts/deploy-functions.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project patro-rules-test \"node firestore-tests/rules.test.mjs\"",
    "deploy:rules": "firebase deploy --only firestore:rules --project patro-management-2024",
    "test:functions": "firebase emulators:exec --only firestore --project patro-rules-test \"node --test --test-concurrency=1 functions/test/totp.test.js functions/test/iban.test.js functions/test/paymentSecurity.emulator.test.js functions/test/jobReminder.emulator.test.js\""
  },
  "dependencies": {
    "firebase": "^12.1.0",
    "lucide-react": "^0.539.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "vite": "^7.1.2"
  }
}
